+#!/usr/bin/env python3
+#
+# Copyright 2025 Ettus Research, a National Instruments Brand
+#
+# SPDX-License-Identifier: GPL-3.0-or-later
+#
+"""Stream IQ data from an X310 radio channel through the aurora block to a remote device.
+
+Requires an X310 bitfile built with the X310_AA target (SFP0=Aurora, SFP1=1GigE).
+Device control uses the 1GigE interface (default: 192.168.20.2).
+Sampled IQ data is forwarded over the Aurora link without host buffering.
+
+Graph: Radio → DDC → Aurora#0
+
+Usage example:
+  python3 rx_to_aurora.py --addr 192.168.20.2 --freq 2.4e9 --rate 10e6 --gain 20
+"""
+
+import argparse
+import signal
+import sys
+import time
+
+import uhd
+import uhd.rfnoc
+from rfnoc_oot_blocks import AuroraBlockControl
+
+
+# Maps UHD channel index to (radio_block_id, ddc_block_id, block_port).
+# ch0/ch1 = DB-A (Radio#0), ch2/ch3 = DB-B (Radio#1).
+CHANNEL_MAP = {
+    0: ("0/Radio#0", "0/DDC#0", 0),
+    1: ("0/Radio#0", "0/DDC#0", 1),
+    2: ("0/Radio#1", "0/DDC#1", 0),
+    3: ("0/Radio#1", "0/DDC#1", 1),
+}
+
+
+def parse_args():
+    description = __doc__
+    parser = argparse.ArgumentParser(
+        formatter_class=argparse.RawTextHelpFormatter, description=description
+    )
+    parser.add_argument(
+        "--addr",
+        default="192.168.20.2",
+        help="X310 IP address — 1GigE/SFP1 interface (default: 192.168.20.2)",
+    )
+    parser.add_argument(
+        "--freq",
+        type=float,
+        default=1e9,
+        metavar="HZ",
+        help="RX center frequency in Hz (default: 1e9)",
+    )
+    parser.add_argument(
+        "--rate",
+        type=float,
+        default=1e6,
+        metavar="SPS",
+        help="RX output sample rate in samples/sec (default: 1e6)",
+    )
+    parser.add_argument(
+        "--gain",
+        type=float,
+        default=0.0,
+        metavar="DB",
+        help="RX gain in dB (default: 0.0)",
+    )
+    parser.add_argument(
+        "--antenna",
+        default="RX2",
+        help="RX antenna port (default: RX2)",
+    )
+    parser.add_argument(
+        "--channel",
+        type=int,
+        default=0,
+        choices=[0, 1, 2, 3],
+        help="UHD channel: 0=DB-A/ch0, 1=DB-A/ch1, 2=DB-B/ch0, 3=DB-B/ch1 (default: 0)",
+    )
+    parser.add_argument(
+        "--aurora-channel",
+        type=int,
+        default=0,
+        choices=[0, 1],
+        help="Aurora block input port to route IQ data to (default: 0)",
+    )
+    parser.add_argument(
+        "--aurora-block",
+        default="0/Aurora#0",
+        help="Aurora RFNoC block ID (default: 0/Aurora#0)",
+    )
+    parser.add_argument(
+        "--link-timeout",
+        type=float,
+        default=5.0,
+        metavar="SEC",
+        help="Seconds to wait for Aurora link up (default: 5.0)",
+    )
+    parser.add_argument(
+        "--stats-interval",
+        type=float,
+        default=1.0,
+        metavar="SEC",
+        help="Seconds between Aurora statistics prints (default: 1.0)",
+    )
+    return parser.parse_args()
+
+
+def wait_for_link_up(aurora_ctrl, timeout):
+    """Poll aurora link status until up or timeout. Returns (link_up, elapsed)."""
+    start = time.time()
+    while True:
+        elapsed = time.time() - start
+        if aurora_ctrl.get_link_status():
+            return True, elapsed
+        if elapsed >= timeout:
+            return False, elapsed
+        time.sleep(0.1)
+
+
+def main():
+    args = parse_args()
+
+    print(f"Connecting to X310 at addr={args.addr} ...")
+    graph = uhd.rfnoc.RfnocGraph(f"addr={args.addr}")
+
+    radio_id, ddc_id, block_port = CHANNEL_MAP[args.channel]
+    print(
+        f"Channel {args.channel}: {radio_id}:{block_port} → {ddc_id}:{block_port}"
+        f" → {args.aurora_block}:{args.aurora_channel}"
+    )
+
+    # Acquire block controls
+    radio_ctrl = uhd.rfnoc.RadioControl(graph.get_block(radio_id))
+    ddc_ctrl = uhd.rfnoc.DdcBlockControl(graph.get_block(ddc_id))
+    aurora_ctrl = AuroraBlockControl(graph.get_block(args.aurora_block))
+
+    # Configure radio RX
+    actual_freq = radio_ctrl.set_rx_frequency(args.freq, block_port)
+    actual_gain = radio_ctrl.set_rx_gain(args.gain, block_port)
+    radio_ctrl.set_rx_antenna(args.antenna, block_port)
+    print(
+        f"Radio configured: freq={actual_freq/1e6:.4f} MHz"
+        f"  gain={actual_gain:.1f} dB  ant={args.antenna}"
+    )
+
+    # Set DDC output rate (decimation is computed automatically)
+    actual_rate = ddc_ctrl.set_output_rate(args.rate, block_port)
+    print(f"DDC output rate : {actual_rate/1e6:.4f} Msps")
+
+    # Enable aurora TX datapath and wait for physical link
+    aurora_ctrl.tx_datapath_enable(True)
+    print(f"Waiting for Aurora link (timeout={args.link_timeout:.1f}s) ...")
+    link_up, elapsed = wait_for_link_up(aurora_ctrl, args.link_timeout)
+    if not link_up:
+        print(f"ERROR: Aurora link did not come up within {elapsed:.1f}s")
+        sys.exit(1)
+    print(f"Aurora link up after {elapsed:.2f}s")
+
+    # Build the RFNoC graph: Radio → DDC → Aurora
+    # These override the default static DDC→endpoint connections so data
+    # flows directly to the Aurora block without a host-side streamer.
+    graph.connect(radio_id, block_port, ddc_id, block_port, False)
+    graph.connect(ddc_id, block_port, args.aurora_block, args.aurora_channel, False)
+    graph.commit()
+    print("RFNoC graph committed")
+
+    # Start continuous streaming from radio
+    stream_cmd = uhd.types.StreamCMD(uhd.types.StreamMode.start_cont)
+    stream_cmd.stream_now = True
+    radio_ctrl.issue_stream_cmd(stream_cmd, block_port)
+    print("Streaming started — press Ctrl+C to stop\n")
+
+    # Handle Ctrl+C
+    stop = False
+
+    def _handle_sigint(sig, frame):
+        nonlocal stop
+        stop = True
+
+    signal.signal(signal.SIGINT, _handle_sigint)
+
+    # Print periodic aurora statistics
+    prev_tx = aurora_ctrl.get_aurora_tx_packet_counter()
+    prev_time = time.time()
+
+    header = f"{'Elapsed':>8}  {'TX pkts':>12}  {'pkt/s':>10}  {'Overflows':>10}"
+    print(header)
+    print("-" * len(header))
+
+    t_start = time.time()
+    while not stop:
+        time.sleep(args.stats_interval)
+        now = time.time()
+        tx = aurora_ctrl.get_aurora_tx_packet_counter()
+        overflow = aurora_ctrl.get_aurora_overflow_counter()
+        dt = now - prev_time
+        pps = (tx - prev_tx) / dt if dt > 0 else 0.0
+        elapsed = now - t_start
+        print(f"{elapsed:>7.1f}s  {tx:>12}  {pps:>10.1f}  {overflow:>10}")
+        prev_tx = tx
+        prev_time = now
+
+    # Stop the stream
+    print("\nStopping stream ...")
+    stop_cmd = uhd.types.StreamCMD(uhd.types.StreamMode.stop_cont)
+    radio_ctrl.issue_stream_cmd(stop_cmd, block_port)
+
+    # Final statistics
+    print("\nFinal Aurora statistics:")
+    print(f"  TX packets : {aurora_ctrl.get_aurora_tx_packet_counter()}")
+    print(f"  RX packets : {aurora_ctrl.get_aurora_rx_packet_counter()}")
+    print(f"  Overflows  : {aurora_ctrl.get_aurora_overflow_counter()}")
+    print("Done.")
+
+
+if __name__ == "__main__":
+    main()
