diff --git a/icores/x310_Aurora_rfnoc_image_core.yml b/icores/x310_Aurora_rfnoc_image_core.yml
new file mode 100644
index 0000000..e934984
--- /dev/null
+++ b/icores/x310_Aurora_rfnoc_image_core.yml
@@ -0,0 +1,76 @@
+# General parameters
+# -----------------------------------------
+schema: rfnoc_imagebuilder_args
+copyright: >-
+  Copyright 2025 Ettus Research, a National Instruments Brand
+license: >-
+  SPDX-License-Identifier: LGPL-3.0-or-later
+version: '1.0'
+chdr_width: 64
+device: 'x310'
+image_core_name: 'usrp_x310_fpga_Aurora'
+default_target: 'X310_AA'
+
+# Inherit the standard X310 radio infrastructure (radios, DDC/DUC, stream eps)
+inherit:
+  - 'yaml_include/x3xx_radio_base.yml'
+
+# NOTE: Building this image core requires the following additional changes
+# to the UHD X310 platform files.  These changes are outside the OOT repo:
+#
+# 1. Add sfpp0 / sfpp1 io_ports to x310_bsp.yml (see comment in aurora_x310.yml)
+#
+# 2. Expose the SFP+ aurora signals in x300_core.v / x300.v.  The generated
+#    rfnoc_image_core module will have ports like sfpp0_aurora_refclk_p etc.
+#    These need to be connected to the top-level SFP+ pins.  Example signals
+#    to add to x300_core.v:
+#
+#      input  wire  sfpp0_ref_clk_p,      // XG_CLK_p from x300.v
+#      input  wire  sfpp0_ref_clk_n,      // XG_CLK_n
+#      output wire  sfpp0_tx_p,           // SFP0_TX_p
+#      output wire  sfpp0_tx_n,           // SFP0_TX_n
+#      input  wire  sfpp0_rx_p,           // SFP0_RX_p
+#      input  wire  sfpp0_rx_n,           // SFP0_RX_n
+#
+# 3. When SFPP0 is used for aurora, disable the Ethernet transport on SFPP0
+#    (SFP0 is typically 10GbE in the HG image; the XG image uses both SFPs
+#    for 10GbE).
+
+# Stream endpoints
+# ----------------------------------------
+# ep0-ep3 are defined by x3xx_radio_base.yml (radio channels)
+# ep4-ep5 are for the Aurora block
+stream_endpoints:
+  ep4:
+    buff_size: 65536
+    ctrl: False
+    data: True
+  ep5:
+    buff_size: 65536
+    ctrl: False
+    data: True
+
+# NoC blocks
+# ----------------------------------
+noc_blocks:
+  aurora0:
+    block_desc: 'aurora_x310.yml'
+    parameters:
+      NUM_PORTS: 2
+      SFPP_NUM:  0
+
+# Connections
+# ------------------------------------------
+connections:
+  # Aurora data connections
+  - { srcblk: ep4,     srcport: out0,   dstblk: aurora0, dstport: in_0  }
+  - { srcblk: aurora0, srcport: out_0,  dstblk: ep4,     dstport: in0   }
+  - { srcblk: ep5,     srcport: out0,   dstblk: aurora0, dstport: in_1  }
+  - { srcblk: aurora0, srcport: out_1,  dstblk: ep5,     dstport: in0   }
+
+  # Aurora physical interface — connects to SFP+ 0
+  # Requires sfpp0 device io_port to be defined in x310_bsp.yml
+  - { srcblk: aurora0, srcport: sfpp,   dstblk: _device_, dstport: sfpp0 }
+
+  # BSP connections (from x3xx_radio_base.yml)
+  - { srcblk: _device_, srcport: _none_, dstblk: _device_, dstport: fp_gpio }
diff --git a/icores/yaml_include/x3xx_radio_base.yml b/icores/yaml_include/x3xx_radio_base.yml
new file mode 100644
index 0000000..0cda4ad
--- /dev/null
+++ b/icores/yaml_include/x3xx_radio_base.yml
@@ -0,0 +1,119 @@
+# General parameters
+# -----------------------------------------
+schema: rfnoc_imagebuilder_args         # Identifier for the schema used to validate this file
+copyright: >-                           # Copyright information used in file headers
+  Copyright 2023 Ettus Research, a National Instruments Brand
+license: >-                             # License information used in file headers
+  SPDX-License-Identifier: LGPL-3.0-or-later
+version: '1.0'                          # File version
+chdr_width: 64                          # Bit width of the CHDR bus for this image
+
+# A list of all stream endpoints in design
+# ----------------------------------------
+stream_endpoints:
+  ep0:                                  # Stream endpoint name
+    ctrl: True                          # Endpoint passes control traffic
+    data: True                          # Endpoint passes data traffic
+    buff_size: 32768                    # Ingress buffer size for data
+  ep1:
+    ctrl: False
+    data: True
+    buff_size: 0
+  ep2:
+    ctrl: False
+    data: True
+    buff_size: 32768
+  ep3:
+    ctrl: False
+    data: True
+    buff_size: 0
+
+# A list of all NoC blocks in design
+# ----------------------------------
+noc_blocks:
+  duc0:                                 # NoC block name
+    block_desc: 'duc.yml'               # Block device descriptor file
+    parameters:
+      NUM_PORTS: 1
+  ddc0:
+    block_desc: 'ddc.yml'
+    parameters:
+      NUM_PORTS: 2
+  radio0:
+    block_desc: 'radio.yml'
+    parameters:
+      NUM_PORTS: 2
+      EN_COMP_GAIN_TX: 1
+      EN_COMP_GAIN_RX: 1      
+  duc1:
+    block_desc: 'duc.yml'
+    parameters:
+      NUM_PORTS: 1
+  ddc1:
+    block_desc: 'ddc.yml'
+    parameters:
+      NUM_PORTS: 2
+  radio1:
+    block_desc: 'radio.yml'
+    parameters:
+      NUM_PORTS: 2
+      EN_COMP_GAIN_TX: 1
+      EN_COMP_GAIN_RX: 1
+
+# A list of all static connections in design
+# ------------------------------------------
+# Format: A list of connection maps (list of key-value pairs) with the following keys
+#   - srcblk  = Source block to connect
+#   - srcport = Port on the source block to connect
+#   - dstblk  = Destination block to connect
+#   - dstport = Port on the destination block to connect
+connections:
+  # RF A TX
+  - { srcblk: ep0,    srcport: out0,  dstblk: duc0,   dstport: in_0 }
+  - { srcblk: duc0,   srcport: out_0, dstblk: radio0, dstport: in_0 }
+  # This is a fake connection: It signals to the image builder that we are
+  # deliberately not connecting this port, so it doesn't have to print a warning
+  # about it.
+  - { srcblk: _device_,  srcport: _none_, dstblk: radio0, dstport: in_1 }
+  # RF A RX
+  - { srcblk: radio0, srcport: out_0, dstblk: ddc0,   dstport: in_0 }
+  - { srcblk: ddc0,   srcport: out_0, dstblk: ep0,    dstport: in0  }
+  # RF A RX2
+  - { srcblk: radio0, srcport: out_1, dstblk: ddc0,   dstport: in_1 }
+  - { srcblk: ddc0,   srcport: out_1, dstblk: ep1,    dstport: in0  }
+  #
+  # RF B TX
+  - { srcblk: ep2,    srcport: out0,  dstblk: duc1,   dstport: in_0 }
+  - { srcblk: duc1,   srcport: out_0, dstblk: radio1, dstport: in_0 }
+  # See comment above about fake connections.
+  - { srcblk: _device_,  srcport: _none_, dstblk: radio1, dstport: in_1 }
+  # RF B RX
+  - { srcblk: radio1, srcport: out_0, dstblk: ddc1,   dstport: in_0 }
+  - { srcblk: ddc1,   srcport: out_0, dstblk: ep2,    dstport: in0  }
+  # RF B RX2
+  - { srcblk: radio1, srcport: out_1, dstblk: ddc1,   dstport: in_1 }
+  - { srcblk: ddc1,   srcport: out_1, dstblk: ep3,    dstport: in0  }
+  #
+  # BSP Connections
+  - { srcblk: radio0,   srcport: ctrlport, dstblk: _device_, dstport: ctrlport_radio0 }
+  - { srcblk: radio1,   srcport: ctrlport, dstblk: _device_, dstport: ctrlport_radio1 }
+  - { srcblk: _device_, srcport: radio0,   dstblk: radio0,   dstport: radio           }
+  - { srcblk: _device_, srcport: radio1,   dstblk: radio1,   dstport: radio           }
+  - { srcblk: _device_, srcport: time,     dstblk: radio0,   dstport: time            }
+  - { srcblk: _device_, srcport: time,     dstblk: radio1,   dstport: time            }
+
+# A list of all clock domain connections in design
+# ------------------------------------------------
+# Format: A list of connection maps (list of key-value pairs) with the following keys
+#   - srcblk  = Source block to connect (Always "_device"_)
+#   - srcport = Clock domain on the source block to connect
+#   - dstblk  = Destination block to connect
+#   - dstport = Clock domain on the destination block to connect
+clk_domains:
+    - { srcblk: _device_, srcport: radio, dstblk: radio0, dstport: radio }
+    - { srcblk: _device_, srcport: ce,    dstblk: ddc0,   dstport: ce    }
+    - { srcblk: _device_, srcport: ce,    dstblk: duc0,   dstport: ce    }
+    - { srcblk: _device_, srcport: radio, dstblk: radio1, dstport: radio }
+    - { srcblk: _device_, srcport: ce,    dstblk: ddc1,   dstport: ce    }
+    - { srcblk: _device_, srcport: ce,    dstblk: duc1,   dstport: ce    }
+
diff --git a/rfnoc/blocks/aurora_x310.yml b/rfnoc/blocks/aurora_x310.yml
new file mode 100644
index 0000000..6a1ac98
--- /dev/null
+++ b/rfnoc/blocks/aurora_x310.yml
@@ -0,0 +1,103 @@
+schema: rfnoc_modtool_args
+module_name: aurora_x310
+version: "1.0"
+rfnoc_version: "1.0"
+chdr_width: 64
+noc_id: 0xA404A000
+name: Aurora Interface Block (X310)
+description: |
+  Aurora 64B/66B single-lane (10 Gbps) RFNoC block for the USRP X310.
+  Uses an SFP+ port for the Aurora physical link.  Compatible with the
+  same software driver (aurora_block_control) as the X410 aurora block.
+
+parameters:
+  NUM_PORTS: 1
+  SFPP_NUM: 0
+
+clocks:
+  - name: rfnoc_chdr
+    freq: "[]"
+  - name: rfnoc_ctrl
+    freq: "[]"
+
+control:
+  fpga_iface: ctrlport
+  interface_direction: slave
+  fifo_depth: 32
+  clk_domain: rfnoc_chdr
+  ctrlport:
+    byte_mode: False
+    timed: False
+    has_status: False
+
+data:
+  fpga_iface: axis_chdr
+  clk_domain: rfnoc_chdr
+  inputs:
+    in:
+      num_ports: NUM_PORTS
+  outputs:
+    out:
+      num_ports: NUM_PORTS
+
+io_ports:
+  # Physical SFP+ aurora connection.
+  # The X310 BSP must expose a matching sfpp0 / sfpp1 device io_port of
+  # type x3xx_sfpp_aurora.  Add the following to x310_bsp.yml and wire
+  # the signals in x300_core.v / x300.v:
+  #
+  #   sfpp0:
+  #     type: x3xx_sfpp_aurora
+  #     drive: slave
+  #     rename:
+  #       pattern: (.*)
+  #       repl: sfpp0_aurora_\1
+  #   sfpp1:
+  #     type: x3xx_sfpp_aurora
+  #     drive: slave
+  #     rename:
+  #       pattern: (.*)
+  #       repl: sfpp1_aurora_\1
+  sfpp:
+    type: x3xx_sfpp_aurora
+    drive: master
+
+constraints:
+  - fpga/oot-blocks/rfnoc_block_aurora/constraints/sfpp_aurora.xdc
+
+fpga_includes:
+  - include: "fpga/oot-blocks/rfnoc_block_aurora/Makefile.srcs"
+    make_var: "$(RFNOC_BLOCK_AURORA_X310_SRCS)"
+  - include: "fpga/oot-blocks/ip/aurora_x310/Makefile.inc"
+    make_var: "$(IP_AURORA_X310_SRCS) $(AURORA_X310_PHY_SRCS) $(IP_AURORA_X310_EXAMPLE_SRCS)"
+
+io_signatures:
+  x3xx_sfpp_aurora:
+    # X310 SFP+ Aurora physical interface.
+    # Connects the SFP+ GT pins and reference clock to the aurora block.
+    type: master-slave
+    ports:
+      - name: refclk_p
+        type: to-master
+        width: 1
+      - name: refclk_n
+        type: to-master
+        width: 1
+      - name: tx_p
+        type: from-master
+        width: 1
+      - name: tx_n
+        type: from-master
+        width: 1
+      - name: rx_p
+        type: to-master
+        width: 1
+      - name: rx_n
+        type: to-master
+        width: 1
+      - name: link_up
+        type: from-master
+        width: 1
+      - name: activity
+        type: from-master
+        width: 1
diff --git a/rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc b/rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc
new file mode 100644
index 0000000..fe72460
--- /dev/null
+++ b/rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc
@@ -0,0 +1,63 @@
+#
+# Copyright 2025 Ettus Research, a National Instruments Brand
+#
+# SPDX-License-Identifier: LGPL-3.0-or-later
+#
+# Build rules for the aurora_64b66b_pcs_pma Vivado IP and its PHY/MAC wrapper
+# sources used by the aurora_x310_wrapper module.
+#
+# The XCI and wrapper RTL are taken directly from the UHD X300 IP directory
+# ($(UHD_FPGA_DIR)/usrp3/top/x300/ip/aurora_64b66b_pcs_pma/) to avoid
+# duplicating large generated files in this repository.
+#
+# Required build variables:
+#   IP_DIR        : x300 IP directory ($(abspath ./ip) from Makefile.x300.inc)
+#   TOOLS_DIR     : Root of the UHD tools directory (for viv_ip_builder.mak)
+#   IP_BUILD_DIR  : Output directory for generated IP products
+#   ARCH          : FPGA architecture (e.g. kintex7)
+#   PART_ID       : FPGA part identifier (e.g. xc7k410tffg900-2)
+#
+
+include $(TOOLS_DIR)/make/viv_ip_builder.mak
+
+X310_IP_DIR := $(IP_DIR)
+
+# -----------------------------------------------------------------------
+# PHY / MAC RTL wrapper sources (from UHD X300 directory)
+# -----------------------------------------------------------------------
+# These are hand-written RTL files that wrap the Vivado-generated IP.
+# They are compiled alongside the generated netlist.
+
+AURORA_X310_PHY_SRCS := \
+$(X310_IP_DIR)/aurora_64b66b_pcs_pma/aurora_phy_x1.v \
+$(X310_IP_DIR)/aurora_64b66b_pcs_pma/aurora_phy_clk_gen.v
+
+# -----------------------------------------------------------------------
+# Example-design sources generated by Vivado for the IP
+# -----------------------------------------------------------------------
+# aurora_64b66b_pcs_pma_gt_common_wrapper and shared-logic modules are
+# produced in the _ex/ sub-directory during IP generation.
+
+IP_AURORA_X310_EXAMPLE_SRCS = $(addprefix $(IP_BUILD_DIR)/aurora_64b66b_pcs_pma_ex/, \
+aurora_64b66b_pcs_pma_ex.srcs/shared_logic/aurora_64b66b_pcs_pma_clock_module.v \
+aurora_64b66b_pcs_pma_ex.srcs/shared_logic/aurora_64b66b_pcs_pma_gt_common_wrapper.v \
+aurora_64b66b_pcs_pma_ex.srcs/shared_logic/aurora_64b66b_pcs_pma_support_reset_logic.v \
+aurora_64b66b_pcs_pma_ex.srcs/shared_logic/aurora_64b66b_pcs_pma_support.v \
+)
+
+# -----------------------------------------------------------------------
+# Vivado IP XCI / output targets
+# -----------------------------------------------------------------------
+
+IP_AURORA_X310_SRCS := $(IP_BUILD_DIR)/aurora_64b66b_pcs_pma/aurora_64b66b_pcs_pma.xci
+
+IP_AURORA_X310_OUTS := $(addprefix $(IP_BUILD_DIR)/aurora_64b66b_pcs_pma/, \
+aurora_64b66b_pcs_pma.xci.out \
+)
+
+.INTERMEDIATE: IP_AURORA_X310_TRGT
+$(IP_AURORA_X310_SRCS) $(IP_AURORA_X310_OUTS) $(IP_AURORA_X310_EXAMPLE_SRCS) : IP_AURORA_X310_TRGT
+	@:
+
+IP_AURORA_X310_TRGT: $(X310_IP_DIR)/aurora_64b66b_pcs_pma/aurora_64b66b_pcs_pma.xci
+	$(call BUILD_VIVADO_IP,aurora_64b66b_pcs_pma,$(ARCH),$(PART_ID),$(X310_IP_DIR),$(IP_BUILD_DIR),1)
diff --git a/rfnoc/fpga/oot-blocks/rfnoc_block_aurora/Makefile.srcs b/rfnoc/fpga/oot-blocks/rfnoc_block_aurora/Makefile.srcs
