From cd6c3225c78c876c0a1d14cd763044fc0b88a30b Mon Sep 17 00:00:00 2001
From: yuriy <crimea82@protonmail.com>
Date: Fri, 23 Oct 2026 20:48:01 -0400
Subject: [PATCH] ip: aurora_x310: reuse IP_AURORA_64B66B_PCS_PMA_TRGT, avoid
 duplicate build
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

aurora_64b66b_pcs_pma is already built by the UHD X300 Makefile via
IP_AURORA_64B66B_PCS_PMA_TRGT.  Calling BUILD_VIVADO_IP a second time
for the same output directory causes a parallel-build conflict under
make -jN: both jobs run concurrently, the first fails mid-upgrade
(Aurora 12.0→13.0 interface changes cause Vivado to report errors),
and Make aborts even though the second job would have succeeded.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc b/rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc
index fe72460..abdcda1 100644
--- a/rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc
+++ b/rfnoc/fpga/oot-blocks/ip/aurora_x310/Makefile.inc
@@ -59,5 +59,9 @@ aurora_64b66b_pcs_pma.xci.out \
 $(IP_AURORA_X310_SRCS) $(IP_AURORA_X310_OUTS) $(IP_AURORA_X310_EXAMPLE_SRCS) : IP_AURORA_X310_TRGT
 	@:
 
-IP_AURORA_X310_TRGT: $(X310_IP_DIR)/aurora_64b66b_pcs_pma/aurora_64b66b_pcs_pma.xci
-	$(call BUILD_VIVADO_IP,aurora_64b66b_pcs_pma,$(ARCH),$(PART_ID),$(X310_IP_DIR),$(IP_BUILD_DIR),1)
+# The aurora_64b66b_pcs_pma IP is already built by the UHD X300 Makefile via
+# IP_AURORA_64B66B_PCS_PMA_TRGT (defined in ip/aurora_64b66b_pcs_pma/Makefile.inc).
+# Depend on that target rather than calling BUILD_VIVADO_IP a second time for the
+# same output directory, which causes a parallel-build conflict under make -jN.
+IP_AURORA_X310_TRGT: IP_AURORA_64B66B_PCS_PMA_TRGT
+	@:
-- 
2.34.1

